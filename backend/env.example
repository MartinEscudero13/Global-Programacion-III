# Copiar a `.env` y completar con los datos del entorno real.
# Si la contraseña tiene caracteres especiales (@, :, /, #, ...), codificala
# con percent-encoding (por ejemplo `p@ss` -> `p%40ss`).
#
# DATABASE_URL la usan la API y Alembic: `alembic upgrade head` lee la misma
# variable a través de `app.core.config.get_settings()`, así que no hace falta
# una segunda configuración ni escribir la URL en el repositorio.
DATABASE_URL=postgresql+asyncpg://usuario:password@host:5432/base
SQL_ECHO=false
